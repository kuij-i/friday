# ── Friday configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# REQUIRED: your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Model that powers Friday's reasoning. Opus 5.5 is the most capable default.
FRIDAY_MODEL=claude-opus-5-5

# Effort level: low | medium | high | xhigh | max  (higher = smarter + pricier)
FRIDAY_EFFORT=high

# ── Telegram (for talking to Friday from your iPhone) ─────────────────
# Create a bot with @BotFather on Telegram, paste its token here.
TELEGRAM_BOT_TOKEN=

# Your personal Telegram numeric user id (message @userinfobot to get it).
# ONLY this id may talk to Friday. Leave blank to allow the first chatter
# to claim ownership on first message (convenient, less safe).
TELEGRAM_OWNER_ID=

# ── Safety ────────────────────────────────────────────────────────────
# If true, dangerous tools (shell, python, file-write) run WITHOUT asking.
# Keep this false. In the CLI you'll be prompted y/n per action.
FRIDAY_AUTO_APPROVE=false

# Directory Friday is allowed to read/write files in. Defaults to its own
# workspace folder. Keep this scoped to a project dir you trust it with.
FRIDAY_WORKSPACE=./workspace

# Where Friday stores its memory database.
FRIDAY_DB=./data/friday.db
