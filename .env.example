# ── Friday configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# ── Which AI powers Friday ────────────────────────────────────────────
# Set ONE of these keys. Friday picks the provider from whichever is set,
# or force it with FRIDAY_PROVIDER=anthropic | nvidia.
#
# Claude (Anthropic) — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# NVIDIA hosted models — get a key (starts with nvapi-) at https://build.nvidia.com/
NVIDIA_API_KEY=
FRIDAY_PROVIDER=auto

# Model. Leave blank for the provider's default:
#   anthropic -> claude-opus-5-5
#   nvidia    -> nvidia/nemotron-3-super-120b-a12b  (any build.nvidia.com model
#                that supports tool calling works)
FRIDAY_MODEL=

# Claude only: effort level low | medium | high | xhigh | max (higher = smarter + pricier)
FRIDAY_EFFORT=high

# ── Telegram (for talking to Friday from your iPhone) ─────────────────
# Create a bot with @BotFather on Telegram, paste its token here.
TELEGRAM_BOT_TOKEN=

# Your personal Telegram numeric user id (message @userinfobot to get it).
# ONLY this id may talk to Friday, and only in a private chat. Set it.
# Required for the Windows auto-start task.
#
# If you leave it blank, `python run.py telegram` starts in PAIRING MODE: it
# prints a one-time code (like ABCD-EF23) in the terminal, valid for 10
# minutes, single use, 5 wrong tries in total. Send `/pair <code>` to the bot
# in a private chat; Friday then prints your id so you can pin it here.
# Nobody can claim the bot without that code. To forget a paired owner:
#   python run.py telegram --reset-owner
TELEGRAM_OWNER_ID=

# ── Safety ────────────────────────────────────────────────────────────
# ⚠ If true, EVERY action — shell commands, Python, file writes, memory —
# runs WITHOUT asking, in the CLI and in Telegram. Keep this false.
# Otherwise the CLI asks y/N per action and Telegram shows ✅/❌ buttons.
FRIDAY_AUTO_APPROVE=false

# Telegram: seconds an approval request waits for your tap before it is
# denied (10–900).
FRIDAY_TELEGRAM_APPROVAL_TIMEOUT=120
# Telegram: default length of /trust_on in minutes (1–120). Trust only
# auto-approves small actions (files, memory, reminders); shell, Python and
# self-coding always ask.
FRIDAY_TRUST_MINUTES=15

# Directory Friday is allowed to read/write files in. Defaults to its own
# workspace folder. Keep this scoped to a project dir you trust it with.
FRIDAY_WORKSPACE=./workspace

# Where Friday stores its memory database.
FRIDAY_DB=./data/friday.db

# ── Capabilities ──────────────────────────────────────────────────────
# Let Friday search the web (Claude server-side search; not available on NVIDIA).
FRIDAY_WEB_SEARCH=true
FRIDAY_WEB_SEARCH_MAX_USES=5

# Whisper model size for transcribing Telegram voice notes (local, optional).
# tiny | base | small | medium | large-v3  (bigger = more accurate, slower).
FRIDAY_WHISPER_MODEL=base

# ── Phase 2: guarded self-coding (advanced, off by default) ───────────
# When true, Friday gains a tool to propose changes to its OWN code. Changes
# are staged on a git branch and tested, never auto-merged — you review/merge.
FRIDAY_SELF_CODING=false
# Git repo Friday proposes changes against (defaults to the current directory).
FRIDAY_REPO_ROOT=.
